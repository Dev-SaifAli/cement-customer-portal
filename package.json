{
  "name": "cement-customer-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "docs:generate": "node documentation/user-guide/generate-user-guide.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend && npm run test -w frontend",
    "migrate:up": "npm run migrate:up -w database",
    "migrate:down": "npm run migrate:down -w database",
    "seed:logistics": "npm run seed:logistics -w database"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
