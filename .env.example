# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1

# PostgreSQL (use either DATABASE_URL or the individual PG_* values)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/cement_portal
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=cement_portal
PG_USER=postgres
PG_PASSWORD=change-me
PG_SSL=false
PG_POOL_MAX=10
QUOTATION_VAT_RATE=0.15

# Authentication foundation (not consumed until authentication is implemented)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
SESSION_SECRET=replace-with-a-different-long-random-secret
CAPTCHA_TTL_MS=120000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# File storage foundation
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./storage
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Browser-exposed values must use the VITE_ prefix
VITE_API_URL=http://localhost:3000/api/v1

# VAS Cloud Logistics (disabled until the final VAS contract is provided)
VAS_ENABLED=false
VAS_BASE_URL=
VAS_ORDER_ENDPOINT=
VAS_COMPANY_CODE=
VAS_TIMEOUT_MS=
